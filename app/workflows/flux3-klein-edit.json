{
  "id": "flux3-klein-edit",
  "name": "FLUX3-Klein 參考圖編輯（1 到 10 張）",
  "kind": "image",
  "mode": "i2i",
  "description": "1 張參考圖：照指令修改原圖。2 到 10 張：把多張圖的人物、物件、場景合成一張，提示詞用「第一張圖的…」指名。",
  "builtin": true,
  "verified": true,
  "frameRule": "any",
  "maxFrames": 0,
  "defaultFps": 0,
  "graph": {
    "1": {"class_type": "UNETLoader", "_meta": {"title": "載入 FLUX3-Klein"},
          "inputs": {"unet_name": "flux3-image-klein-int8-convrot.safetensors", "weight_dtype": "default"}},
    "2": {"class_type": "ModelSamplingFlux", "_meta": {"title": "取樣偏移"},
          "inputs": {"model": ["1", 0], "max_shift": 2.77259, "base_shift": 2.77259, "width": 1024, "height": 1024}},
    "3": {"class_type": "CLIPLoader", "_meta": {"title": "載入文字編碼器"},
          "inputs": {"clip_name": "qwen3vl_4b_int8_convrot.safetensors", "type": "flux3", "device": "default"}},
    "4": {"class_type": "VAELoader", "_meta": {"title": "載入 VAE"},
          "inputs": {"vae_name": "flux2-vae.safetensors"}},
    "5": {"class_type": "CLIPTextEncode", "_meta": {"title": "正向提示詞"},
          "inputs": {"text": "", "clip": ["3", 0]}},
    "6": {"class_type": "CLIPTextEncode", "_meta": {"title": "負向提示詞"},
          "inputs": {"text": "", "clip": ["3", 0]}},
    "7": {"class_type": "ReferenceMultiLatent", "_meta": {"title": "參考圖"},
          "inputs": {"positive": ["5", 0], "negative": ["6", 0], "vae": ["4", 0], "resolution": "resize",
                     "resolution.megapixels": 1.0}},
    "8": {"class_type": "EmptyFlux2LatentImage", "_meta": {"title": "空白畫布"},
          "inputs": {"width": 1024, "height": 1024, "batch_size": 1}},
    "9": {"class_type": "KSampler", "_meta": {"title": "取樣"},
          "inputs": {"model": ["2", 0], "seed": 0, "steps": 16, "cfg": 1.0, "sampler_name": "euler",
                     "scheduler": "simple", "positive": ["7", 0], "negative": ["7", 1],
                     "latent_image": ["8", 0], "denoise": 1.0}},
    "10": {"class_type": "VAEDecode", "_meta": {"title": "解碼"},
           "inputs": {"samples": ["9", 0], "vae": ["4", 0]}},
    "11": {"class_type": "SaveImage", "_meta": {"title": "儲存圖片"},
           "inputs": {"images": ["10", 0], "filename_prefix": "vc/image"}}
  },
  "bindings": {
    "prompt": [{"node": "5", "input": "text"}],
    "negative": [{"node": "6", "input": "text"}],
    "seed": [{"node": "9", "input": "seed"}],
    "width": [{"node": "8", "input": "width"}],
    "height": [{"node": "8", "input": "height"}],
    "images": [{"node": "7", "input": "images.image"}],
    "steps": [{"node": "9", "input": "steps"}],
    "refMegapixels": [{"node": "7", "input": "resolution.megapixels"}],
    "prefix": [{"node": "11", "input": "filename_prefix"}]
  },
  "params": [
    {"key": "steps", "label": "步數", "type": "int", "min": 8, "max": 30, "step": 1, "default": 16},
    {"key": "refMegapixels", "label": "參考圖解析度", "type": "float", "min": 0.25, "max": 2, "step": 0.05,
     "default": 1.0, "help": "每張參考圖縮放到幾百萬像素。張數多時調低，省顯示記憶體與時間"}
  ],
  "outputs": ["11"],
  "notes": "來源：FLUX3-Klein進階 FK-03、FK-04。Klein 是整張重畫，不是逐像素保留，鏡頭的參考強度對這個範本無效，要保留或修改什麼請寫進提示詞。原圖沒拍到的部分也要寫進提示詞。實測 RTX 4050 6GB、1280×720：2 張參考圖從 APP 送出約 52 秒（模型已載入），直接送 ComfyUI 約 107 秒；10 張、參考圖解析度 0.5 約 220 秒。",
  "download": []
}
