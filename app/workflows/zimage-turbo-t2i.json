{
  "id": "zimage-turbo-t2i",
  "name": "Z-Image Turbo 文生圖",
  "kind": "image",
  "mode": "t2i",
  "description": "Z-Image Turbo（fp8 量化版）快速出圖，8 到 10 步即可。在 RTX 4050 Laptop 6GB 上實測過。",
  "builtin": true,
  "verified": true,
  "frameRule": "any",
  "maxFrames": 0,
  "defaultFps": 0,
  "graph": {
    "1": {"class_type": "UNETLoader", "_meta": {"title": "載入 Z-Image Turbo"},
          "inputs": {"unet_name": "zImageTurboQuantized_fp8E4m3fn.safetensors", "weight_dtype": "default"}},
    "2": {"class_type": "CLIPLoader", "_meta": {"title": "載入文字編碼器"},
          "inputs": {"clip_name": "qwen_3_4b.safetensors", "type": "lumina2", "device": "default"}},
    "3": {"class_type": "VAELoader", "_meta": {"title": "載入 VAE"},
          "inputs": {"vae_name": "ae.safetensors"}},
    "4": {"class_type": "CLIPTextEncode", "_meta": {"title": "正向提示詞"},
          "inputs": {"text": "", "clip": ["2", 0]}},
    "5": {"class_type": "CLIPTextEncode", "_meta": {"title": "負向提示詞"},
          "inputs": {"text": "blurry ugly bad", "clip": ["2", 0]}},
    "6": {"class_type": "EmptySD3LatentImage", "_meta": {"title": "畫布尺寸"},
          "inputs": {"width": 768, "height": 448, "batch_size": 1}},
    "7": {"class_type": "KSampler", "_meta": {"title": "取樣"},
          "inputs": {"model": ["1", 0], "seed": 0, "steps": 10, "cfg": 1.0, "sampler_name": "dpmpp_2m_sde",
                     "scheduler": "sgm_uniform", "positive": ["4", 0], "negative": ["5", 0],
                     "latent_image": ["6", 0], "denoise": 1.0}},
    "8": {"class_type": "VAEDecode", "_meta": {"title": "解碼"},
          "inputs": {"samples": ["7", 0], "vae": ["3", 0]}},
    "9": {"class_type": "SaveImage", "_meta": {"title": "儲存圖片"},
          "inputs": {"images": ["8", 0], "filename_prefix": "vc/image"}}
  },
  "bindings": {
    "prompt": [{"node": "4", "input": "text"}],
    "negative": [{"node": "5", "input": "text"}],
    "seed": [{"node": "7", "input": "seed"}],
    "width": [{"node": "6", "input": "width"}],
    "height": [{"node": "6", "input": "height"}],
    "steps": [{"node": "7", "input": "steps"}],
    "cfg": [{"node": "7", "input": "cfg"}],
    "sampler": [{"node": "7", "input": "sampler_name"}],
    "scheduler": [{"node": "7", "input": "scheduler"}],
    "prefix": [{"node": "9", "input": "filename_prefix"}]
  },
  "params": [
    {"key": "steps", "label": "步數", "type": "int", "min": 4, "max": 30, "step": 1, "default": 10,
     "help": "Turbo 模型 8 到 10 步就夠，步數越多越慢"},
    {"key": "cfg", "label": "CFG", "type": "float", "min": 1, "max": 4, "step": 0.1, "default": 1.0,
     "help": "維持 1 最快；調高才會讓負向提示詞生效，但速度約慢一倍"},
    {"key": "sampler", "label": "取樣器", "type": "select", "default": "dpmpp_2m_sde",
     "options": [{"value": "dpmpp_2m_sde", "label": "dpmpp_2m_sde（預設）"},
                 {"value": "res_multistep", "label": "res_multistep"},
                 {"value": "euler", "label": "euler"}]},
    {"key": "scheduler", "label": "排程", "type": "select", "default": "sgm_uniform",
     "options": [{"value": "sgm_uniform", "label": "sgm_uniform（預設）"},
                 {"value": "simple", "label": "simple"},
                 {"value": "beta", "label": "beta"}]}
  ],
  "outputs": ["9"],
  "notes": "取自作者 ComfyUI 上的 Z-image_turbo 工作流程（ModelSamplingAuraFlow 原本就是停用狀態，這裡省略）。",
  "download": []
}
