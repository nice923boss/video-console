{
  "id": "upscale-refine-zimage",
  "name": "放大精修（Z-Image 重繪細節）",
  "kind": "upscale",
  "mode": "upscale",
  "description": "先統一到約 100 萬像素，4 倍模型放大後縮回 2 倍，再用 Z-Image 低強度重畫補細節，最後校正色彩。比快速放大慢，細節較多。",
  "builtin": true,
  "verified": true,
  "frameRule": "any",
  "maxFrames": 0,
  "defaultFps": 0,
  "graph": {
    "1": {"class_type": "UNETLoader", "_meta": {"title": "載入 Z-Image Turbo"},
          "inputs": {"unet_name": "zImageTurboQuantized_fp8E4m3fn.safetensors", "weight_dtype": "default"}},
    "2": {"class_type": "ModelSamplingAuraFlow", "_meta": {"title": "取樣位移"},
          "inputs": {"model": ["1", 0], "shift": 3.0}},
    "3": {"class_type": "CLIPLoader", "_meta": {"title": "載入文字編碼器"},
          "inputs": {"clip_name": "qwen_3_4b.safetensors", "type": "lumina2", "device": "default"}},
    "4": {"class_type": "VAELoader", "_meta": {"title": "載入 VAE"},
          "inputs": {"vae_name": "ae.safetensors"}},
    "5": {"class_type": "LoadImage", "_meta": {"title": "原圖"},
          "inputs": {"image": "example.png"}},
    "6": {"class_type": "ImageScaleToTotalPixels", "_meta": {"title": "統一到約 100 萬像素"},
          "inputs": {"image": ["5", 0], "upscale_method": "lanczos", "megapixels": 1.0, "resolution_steps": 64}},
    "7": {"class_type": "CLIPTextEncode", "_meta": {"title": "畫面描述"},
          "inputs": {"text": "", "clip": ["3", 0]}},
    "8": {"class_type": "ConditioningZeroOut", "_meta": {"title": "空白負向"},
          "inputs": {"conditioning": ["7", 0]}},
    "9": {"class_type": "UpscaleModelLoader", "_meta": {"title": "載入放大模型"},
          "inputs": {"model_name": "4x-UltraSharp.pth"}},
    "10": {"class_type": "ImageUpscaleWithModel", "_meta": {"title": "4 倍放大"},
           "inputs": {"upscale_model": ["9", 0], "image": ["6", 0]}},
    "11": {"class_type": "ImageScaleBy", "_meta": {"title": "縮回 2 倍"},
           "inputs": {"image": ["10", 0], "upscale_method": "lanczos", "scale_by": 0.5}},
    "12": {"class_type": "VAEEncodeTiled", "_meta": {"title": "分塊編碼"},
           "inputs": {"pixels": ["11", 0], "vae": ["4", 0], "tile_size": 1024, "overlap": 64,
                      "temporal_size": 64, "temporal_overlap": 8}},
    "13": {"class_type": "KSampler", "_meta": {"title": "低強度重畫"},
           "inputs": {"model": ["2", 0], "seed": 0, "steps": 5, "cfg": 1.0, "sampler_name": "res_multistep",
                      "scheduler": "simple", "positive": ["7", 0], "negative": ["8", 0],
                      "latent_image": ["12", 0], "denoise": 0.25}},
    "14": {"class_type": "VAEDecodeTiled", "_meta": {"title": "分塊解碼"},
           "inputs": {"samples": ["13", 0], "vae": ["4", 0], "tile_size": 1024, "overlap": 64,
                      "temporal_size": 64, "temporal_overlap": 8}},
    "15": {"class_type": "ColorMatch", "_meta": {"title": "色彩校正"},
           "inputs": {"image_ref": ["11", 0], "image_target": ["14", 0], "method": "mkl", "strength": 1.0,
                      "multithread": true}},
    "16": {"class_type": "SaveImage", "_meta": {"title": "儲存圖片"},
           "inputs": {"images": ["15", 0], "filename_prefix": "vc/refine"}}
  },
  "bindings": {
    "image": [{"node": "5", "input": "image"}],
    "prompt": [{"node": "7", "input": "text"}],
    "seed": [{"node": "13", "input": "seed"}],
    "denoise": [{"node": "13", "input": "denoise"}],
    "steps": [{"node": "13", "input": "steps"}],
    "prefix": [{"node": "16", "input": "filename_prefix"}]
  },
  "params": [
    {"key": "denoise", "label": "精修強度", "type": "float", "min": 0.1, "max": 0.5, "step": 0.05,
     "default": 0.25, "help": "越高補越多細節，但可能改變五官與文字；建議 0.2 到 0.3"},
    {"key": "steps", "label": "步數", "type": "int", "min": 3, "max": 12, "step": 1, "default": 5}
  ],
  "outputs": ["16"],
  "notes": "對應作者 ComfyUI 上的 ZI-03 既有圖片放大精修工作流程。需要 KJNodes 的 ColorMatch 節點。輸出約 400 萬像素。",
  "download": []
}
