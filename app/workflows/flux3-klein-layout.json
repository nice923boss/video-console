{
  "id": "flux3-klein-layout",
  "name": "FLUX3-Klein 版面配置海報",
  "kind": "image",
  "mode": "t2i",
  "description": "用元素表指定每個文字與物件的位置，適合海報與字卡。提示詞用 <obj_1>、<obj_2> 對應元素表的第幾個元素。",
  "builtin": true,
  "verified": true,
  "allowText": true,
  "frameRule": "any",
  "maxFrames": 0,
  "defaultFps": 0,
  "graph": {
    "1": {"class_type": "UNETLoader", "_meta": {"title": "載入 FLUX3-Klein"},
          "inputs": {"unet_name": "flux3-image-klein-int8-convrot.safetensors", "weight_dtype": "default"}},
    "2": {"class_type": "ModelSamplingFlux", "_meta": {"title": "取樣偏移"},
          "inputs": {"model": ["1", 0], "max_shift": 2.77259, "base_shift": 2.77259, "width": 1024, "height": 1024}},
    "3": {"class_type": "CLIPLoader", "_meta": {"title": "載入文字編碼器"},
          "inputs": {"clip_name": "qwen3vl_4b_int8_convrot.safetensors", "type": "flux3", "device": "default"}},
    "4": {"class_type": "VAELoader", "_meta": {"title": "載入 VAE"},
          "inputs": {"vae_name": "flux2-vae.safetensors"}},
    "5": {"class_type": "PrimitiveStringMultiline", "_meta": {"title": "元素表"},
          "inputs": {"value": "[]"}},
    "6": {"class_type": "CreateBoundingBoxes", "_meta": {"title": "版面框"},
          "inputs": {"width": 1024, "height": 1024, "editor_state": {"__value__": []}, "bboxes": ["5", 0]}},
    "7": {"class_type": "Flux3LayoutPrompt", "_meta": {"title": "版面提示詞"},
          "inputs": {"prompt": "", "element": ["6", 2]}},
    "8": {"class_type": "CLIPTextEncode", "_meta": {"title": "正向提示詞"},
          "inputs": {"text": ["7", 0], "clip": ["3", 0]}},
    "9": {"class_type": "CLIPTextEncode", "_meta": {"title": "負向提示詞"},
          "inputs": {"text": "", "clip": ["3", 0]}},
    "10": {"class_type": "EmptyFlux2LatentImage", "_meta": {"title": "空白畫布"},
           "inputs": {"width": 1024, "height": 1024, "batch_size": 1}},
    "11": {"class_type": "KSampler", "_meta": {"title": "取樣"},
           "inputs": {"model": ["2", 0], "seed": 0, "steps": 16, "cfg": 1.0, "sampler_name": "euler",
                      "scheduler": "simple", "positive": ["8", 0], "negative": ["9", 0],
                      "latent_image": ["10", 0], "denoise": 1.0}},
    "12": {"class_type": "VAEDecode", "_meta": {"title": "解碼"},
           "inputs": {"samples": ["11", 0], "vae": ["4", 0]}},
    "13": {"class_type": "SaveImage", "_meta": {"title": "儲存圖片"},
           "inputs": {"images": ["12", 0], "filename_prefix": "vc/image"}}
  },
  "bindings": {
    "prompt": [{"node": "7", "input": "prompt"}],
    "negative": [{"node": "9", "input": "text"}],
    "seed": [{"node": "11", "input": "seed"}],
    "width": [{"node": "6", "input": "width"}, {"node": "10", "input": "width"}],
    "height": [{"node": "6", "input": "height"}, {"node": "10", "input": "height"}],
    "steps": [{"node": "11", "input": "steps"}],
    "layout": [{"node": "5", "input": "value"}],
    "prefix": [{"node": "13", "input": "filename_prefix"}]
  },
  "params": [
    {"key": "layout", "label": "元素表", "type": "string", "multiline": true,
     "default": "[{\"type\":\"text\",\"text\":\"SUMMER SALE\",\"desc\":\"bold black headline\",\"bbox\":[40,80,220,920]},{\"type\":\"obj\",\"desc\":\"a red bicycle\",\"bbox\":[560,40,950,520]},{\"type\":\"obj\",\"desc\":\"a tall green potted cactus\",\"bbox\":[420,600,960,900]},{\"type\":\"obj\",\"desc\":\"a small blue circle badge\",\"bbox\":[260,700,420,860]}]",
     "help": "JSON 陣列。type 是 text（要寫的字）或 obj（物件）；bbox 依序是上、左、下、右，範圍 0 到 1000"},
    {"key": "steps", "label": "步數", "type": "int", "min": 8, "max": 30, "step": 1, "default": 16}
  ],
  "outputs": ["13"],
  "notes": "來源：FLUX3-Klein進階 FK-02。這個範本會畫字，不套用「畫面不畫字」的過濾。提示詞範例：A minimalist summer poster on a pale yellow background with a bold headline <obj_1>, a red bicycle <obj_2>, a tall green potted cactus <obj_3>, and a small blue circle badge <obj_4>. Klein 常在主標題外補上假字，出圖後請檢查。",
  "download": []
}
